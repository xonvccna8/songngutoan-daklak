# Firebase web (Firebase Console > Project settings > Your apps > Web app). Công khai được, nhưng vẫn để ở đây.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Firebase Admin (Project settings > Service accounts > Generate new private key). BÍ MẬT, không chia sẻ.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Quản trị: email (cách nhau dấu phẩy) tự được cấp quyền quản trị khi đăng nhập lần đầu
ADMIN_EMAILS=
DEFAULT_SCHOOL_ID=thcs-mau
DEFAULT_SCHOOL_NAME=THCS Mẫu

# Việc chạy hằng ngày (nhắc bài trước hạn) — chuỗi ngẫu nhiên dài; Vercel Cron tự gửi kèm. BÍ MẬT.
CRON_SECRET=

# Trợ lý AI soạn bài (GĐ 6b) — platform.openai.com > API keys. BÍ MẬT.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Tùy chọn (giai đoạn 6)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Lượt AI dùng thử mỗi tài khoản (mặc định 10) và mật khẩu mở khoá khi hết lượt
AI_FREE_LIMIT=10
AI_UNLOCK_PASSWORD=
