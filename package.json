{
    "name": "lop-song-ngu",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "test": "vitest run",
        "test:rules": "firebase emulators:exec --only firestore --project demo-lsn \"vitest run tests/firestore.rules.test.ts\"",
        "test:emulator": "firebase emulators:exec --only firestore --project demo-lsn \"vitest run tests/games.emulator.test.ts\"",
        "test:features": "firebase emulators:exec --only firestore --project demo-lsn \"vitest run --no-file-parallelism tests/features.rules.test.ts tests/features.emulator.test.ts\"",
        "seed": "tsx scripts/seed.mts",
        "seed:clear": "tsx scripts/seed.mts --clear",
        "seed:lesson": "tsx scripts/seed-lesson.mts",
        "seed:kho": "tsx scripts/seed-kho.mts",
        "seed:bank": "tsx scripts/seed-bank.mts",
        "seed:history": "tsx scripts/seed-history.mts",
        "deploy:rules": "node scripts/deploy-rules.mjs",
        "indexes": "node scripts/create-indexes.mjs",
        "check": "node scripts/check-firebase.mjs",
        "make-admin": "tsx scripts/make-admin.mts"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "bcryptjs": "^3.0.3",
        "canvas-confetti": "^1.9.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cn": "^0.4.0",
        "docx": "^9.10.0",
        "firebase": "^13.0.0",
        "firebase-admin": "^13.10.0",
        "lucide-react": "^1.55.0",
        "motion": "^14.1.1",
        "next": "16.4.2",
        "pptxgenjs": "^3.12.0",
        "qrcode": "^1.5.4",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "recharts": "^3.10.1",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tw-animate-css": "^1.4.0",
        "write-excel-file": "^4.1.1"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^6.0.0",
        "@tailwindcss/turbopack": "^4",
        "@types/canvas-confetti": "^1.9.0",
        "@types/node": "^24.19.2",
        "@types/qrcode": "^1.5.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.4.2",
        "shadcn": "^4.21.4",
        "tailwindcss": "^4",
        "tsx": "^4.23.15",
        "typescript": "^5",
        "vitest": "^5.0.3"
    },
    "overrides": {
        "@firebase/firestore": {
            "@grpc/grpc-js": "^1.14.6"
        }
    }
